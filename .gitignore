# Godot 4 editor cache & reimported assets (regenerated automatically)
.godot/

# Build artifacts / exported games (large; rebuild via export)
dist/
*.exe
*.pck
*.zip

# Local safety backups & temp files
*.bak
*.bak-*
*.corrupt
*.tmp
*.orig

# Dev screenshot / test-capture output
_shots/

# Web (HTML5) export output — regenerate via the Godot export
web_build/

# OS cruft
Thumbs.db
.DS_Store
