config_version=5

[application]

config/name="Mario (Godot Port)"
run/main_scene="res://Intro.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://sprites/new player/MARIO LOGO.png"

[display]

